import math
import argparse

# ==================================================================== #
#                            Setup argparse                            #
# ==================================================================== #

parser = argparse.ArgumentParser(description='Generate a CRC function')
parser.add_argument('width', type=int,
                    help='size of the CRC in bits')
parser.add_argument('polynomial', type=(lambda x : int(x, 16)),
                    help='generator polynomial ' +
                         '(hex format, normal bit ordering)')

exclusive_group = parser.add_mutually_exclusive_group(required=True)
exclusive_group.add_argument('-l', '--lsbit', action='store_true',
                             help='use least significant bit first')
exclusive_group.add_argument('-m', '--msbit', action='store_true',
                             help='use most significant bit first')

parser.add_argument('-i', '--init', type=int, default=0, metavar='N',
                    help='TODO') # TODO
parser.add_argument('-x', '--xor', type=int, default=0, metavar='N',
                    help='TODO') # TODO
args = parser.parse_args()

# ==================================================================== #
#                            Generate Table                            #
# ==================================================================== #

# TODO error if polynomial is bigger than width
# TODO reverse polynomial if lsbit

def lsbit_crc(num, polynomial, width):
    crc = 0
    for i in range(8):
        feedback = (crc ^ (num >> i)) & 1
        crc = (crc >> 1) ^ (polynomial * feedback)
    return crc

def msbit_crc(num, polynomial, width):
    crc = 0
    for i in reversed(range(8)):
        feedback = ((crc >> (width - 1)) ^ (num >> i)) & 1
        crc = (crc << 1) ^ (polynomial * feedback)
    return crc & ((1 << width) - 1)

crc_func = (lsbit_crc if args.lsbit else msbit_crc)

table = []
for i in range(256):
    entry = crc_func(i, args.polynomial, args.width)
    table.append(entry)

# ==================================================================== #
#                             Print Table                              #
# ==================================================================== #

if args.width <= 8:
    prefix = '.byte'
    entries_per_line = 8
elif args.width <= 16:
    prefix = '.short'
    entries_per_line = 8
elif args.width <= 32:
    prefix = '.int'
    entries_per_line = 4

for i in range(len(table)):
    if i % entries_per_line == 0:
        print(f'\n  {prefix} ', end='')
    else:
        print(', ', end='')
    print(f'0x%0{2 * math.ceil(args.width / 8)}x' % table[i], end='')
print('\n', end='')
