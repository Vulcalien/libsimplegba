import math

# ==================================================================== #
#                              Parameters                              #
# ==================================================================== #

# NOTE: the order of bits is LSBit-first, so use *reversed* polynomials.

# width = 4
# polynomial = 0xc

width = 32
polynomial = 0xedb88320

# ==================================================================== #
#                            Generate Table                            #
# ==================================================================== #

table = []
for i in range(256):
    crc = 0
    for b in range(8):
        feedback = (crc ^ (i >> b)) & 1
        crc = (crc >> 1) ^ (polynomial * feedback)
    table.append(crc)

# ==================================================================== #
#                             Print Table                              #
# ==================================================================== #

if width <= 8:
    prefix = '.byte'
    entries_per_line = 8
elif width <= 16:
    prefix = '.short'
    entries_per_line = 8
elif width <= 32:
    prefix = '.int'
    entries_per_line = 4

for i in range(len(table)):
    if i % entries_per_line == 0:
        print(f'\n  {prefix} ', end='')
    else:
        print(', ', end='')
    print(f'0x%0{2 * math.ceil(width / 8)}x' % table[i], end='')
print('\n', end='')
