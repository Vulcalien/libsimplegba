import math, sys, argparse

# ==================================================================== #
#                           Helper Functions                           #
# ==================================================================== #

def reverse_bits(num, width):
    result = 0
    for i in range(width):
        bit = (num >> i) & 1
        result |= bit << (width - 1 - i)
    return result

# ==================================================================== #
#                            Setup argparse                            #
# ==================================================================== #

parser = argparse.ArgumentParser(description='Generate a CRC function')
parser.add_argument('width', type=int,
                    help='size of the CRC in bits')
parser.add_argument('polynomial', type=(lambda x : int(x, 16)),
                    help='generator polynomial ' +
                         '(hex format, normal bit ordering)')

exclusive_group = parser.add_mutually_exclusive_group(required=True)
exclusive_group.add_argument('-l', '--lsbit', action='store_true',
                             help='use least significant bit first')
exclusive_group.add_argument('-m', '--msbit', action='store_true',
                             help='use most significant bit first')

parser.add_argument('-i', '--init', type=(lambda x : int(x, 16)),
                    default=0, metavar='N',
                    help='initial value of CRC')
parser.add_argument('-x', '--xorout', type=(lambda x : int(x, 16)),
                    default=0, metavar='N',
                    help='number to XOR to the result')

args = parser.parse_args()

# ==================================================================== #
#                         Validate Parameters                          #
# ==================================================================== #

width      = args.width
polynomial = args.polynomial
init       = args.init
xorout     = args.xorout

maxval = (1 << args.width) - 1

if width < 1 or width > 32:
    sys.exit('Error: bit width must be in range [1, 32]')

if polynomial > maxval:
    sys.exit('Error: polynomial exceeds bit width of CRC')

if init > maxval:
    sys.exit('Error: initial value exceeds bit width of CRC')

if xorout > maxval:
    sys.exit('Error: xorout value exceeds bit width of CRC')

# ==================================================================== #
#                            Generate Table                            #
# ==================================================================== #

def crc(num):
    if args.lsbit:
        num = reverse_bits(num, 8)

    crc = 0
    for i in reversed(range(8)):
        feedback = ((crc >> (width - 1)) ^ (num >> i)) & 1
        crc = ((crc << 1) ^ (polynomial * feedback)) & maxval

    if args.lsbit:
        crc = reverse_bits(crc, width)

    return crc

table = [ crc(i) for i in range(256) ]

# ==================================================================== #
#                         Print CRC Parameters                         #
# ==================================================================== #

print('// width=%d'    % width)
print('// poly=0x%x'   % polynomial)
print('// init=0x%x'   % init)
print('// xorout=0x%x' % xorout)
print('// refin=%s'    % 'true' if args.lsbit else 'false')
print('// refout=%s'   % 'true' if args.lsbit else 'false')
print()

# ==================================================================== #
#                             Print Table                              #
# ==================================================================== #

entries_per_line = 4 if width > 16 else 8
hex_digits = 2 * math.ceil(width / 8)

if width <= 8:
    datatype = 'u8'
elif width <= 16:
    datatype = 'u16'
else:
    datatype = 'u32'

print(f'static const {datatype} crc_table[256] = {{', end='')
for i in range(256):
    if i % entries_per_line == 0:
        print('\n    ', end='')
    print(f'0x%0{hex_digits}x' % table[i], end=', ' if i < 255 else '')
print('\n};')
