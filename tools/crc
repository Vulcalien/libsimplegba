import math, sys, argparse

# ==================================================================== #
#                            Setup argparse                            #
# ==================================================================== #

parser = argparse.ArgumentParser(description='Generate a CRC function')
parser.add_argument('width', type=int,
                    help='size of the CRC in bits')
parser.add_argument('polynomial', type=(lambda x : int(x, 16)),
                    help='generator polynomial ' +
                         '(hex format, normal bit ordering)')

exclusive_group = parser.add_mutually_exclusive_group(required=True)
exclusive_group.add_argument('-l', '--lsbit', action='store_true',
                             help='use least significant bit first')
exclusive_group.add_argument('-m', '--msbit', action='store_true',
                             help='use most significant bit first')

parser.add_argument('-i', '--init', type=int, default=0, metavar='N',
                    help='TODO') # TODO
parser.add_argument('-x', '--xor', type=int, default=0, metavar='N',
                    help='TODO') # TODO
args = parser.parse_args()

# ==================================================================== #
#                         Validate Parameters                          #
# ==================================================================== #

if args.width < 1 or args.width > 32:
    sys.exit('Error: bit width must be in range [1, 32]')

if args.polynomial > (1 << args.width) - 1:
    sys.exit('Error: polynomial exceeds bit width of CRC')

# if LSBit, reverse polynomial
if args.lsbit:
    args.polynomial = sum(
        ((args.polynomial >> i) & 1) << (args.width - 1 - i)
        for i in range(args.width)
    )

# ==================================================================== #
#                            Generate Table                            #
# ==================================================================== #

def lsbit_crc(num):
    crc = 0
    for i in range(8):
        feedback = (crc ^ (num >> i)) & 1
        crc = (crc >> 1) ^ (args.polynomial * feedback)
    return crc

def msbit_crc(num):
    crc = 0
    for i in reversed(range(8)):
        feedback = ((crc >> (args.width - 1)) ^ (num >> i)) & 1
        crc = (crc << 1) ^ (args.polynomial * feedback)
    return crc & ((1 << args.width) - 1)

crc_func = (lsbit_crc if args.lsbit else msbit_crc)
table = [ crc_func(i) for i in range(256) ]

# ==================================================================== #
#                             Print Table                              #
# ==================================================================== #

entries_per_line = 4 if args.width > 16 else 8
hex_digits = 2 * math.ceil(args.width / 8)

for i in range(len(table)):
    print(f'0x%0{hex_digits}x, ' % table[i], end='')
    if (i + 1) % entries_per_line == 0:
        print()
