#!/bin/sh

REGEX="TEST([A-Za-z_]*)"
FILES_TO_SEARCH=$(find src -type f -name "*.c")

TESTS=$(grep -ho "$REGEX" $FILES_TO_SEARCH | sed "s/TEST(\(.*\))/\1/")
TEST_FILES=$(grep -l "$REGEX" $FILES_TO_SEARCH | sed "s/src\/\(.*\)/\1/")
TEST_COUNT=$(echo "$TESTS" | wc -l)

OUTPUT=$(
    printf '#include "test.h"\n'
    printf '\n'
    echo "$(for file in $TEST_FILES; do
    printf '#include "%s"' "$file"
    done)"
    printf '\n'
    printf 'void AgbMain(void) {\n'
    printf '    i32 tests_passed = 0;\n'
    printf '\n'
    echo "$(for test in $TESTS; do
    printf '    mgba_puts("%s");\n' "$test"
    printf '    if(test_%s()) {\n' "$test"
    printf '        tests_passed++;\n'
    printf '        mgba_puts("passed");\n'
    printf '    } else {\n'
    printf '        mgba_puts("FAILED");\n'
    printf '    }\n'
    printf '\n'
    done)"
    printf '\n'
    printf '    mgba_printf("Passed: %%d / %%d", tests_passed, %d);\n' "$TEST_COUNT"
    printf '    while(true);\n'
    printf '}\n'
)

echo "$OUTPUT" > src/main.c
